# ==============================================================================
# Шаблон конфигурации окружения для Centralized Auth Server
# Переименуйте этот файл в .env и настройте параметры ниже
# ==============================================================================

# Порт для запуска веб-сервера Flask (по умолчанию 5001)
PORT=5001

# Хост / интерфейс для прослушивания (0.0.0.0 — слушать все интерфейсы)
BIND_HOST=0.0.0.0

# Секретный ключ для подписи сессий Flask (обязательно смените в продакшне)
# Для генерации случайного ключа выполните команду: openssl rand -hex 16
SECRET_KEY=default-secret-key-change-me-please

# Токен для авторизации запросов от доверенных нод (должен совпадать на всех нодах)
# Для генерации случайного токена выполните команду: openssl rand -hex 16
NODE_API_TOKEN=default-token-change-me-please

# Пароль по умолчанию для локального администратора 'admin' (создается при первом запуске)
ADMIN_PASSWORD=admin123

# ==============================================================================
# Настройки интеграции с Active Directory / LDAP
# ==============================================================================
# Включить авторизацию через контроллер домена Active Directory / LDAP (true / false)
LDAP_ENABLED=false

# Сервер LDAP (например, ldap://dc1.company.local:389 или ldaps://dc1.company.local:636)
LDAP_SERVER=ldap://dc1.company.local:389

# Доменная часть для UPN (например, company.local или CORP)
LDAP_DOMAIN=company.local

# Базовый DN поиска пользователей
LDAP_BASE_DN=DC=company,DC=local

# Сервисная учетная запись для первичного поиска (Bind DN или user@domain)
LDAP_BIND_USER=svc_auth@company.local
LDAP_BIND_PASSWORD=YourServicePasswordHere

# Имя группы или полный DN группы в домене, членам которой разрешен вход (например: VPN_Admins или CN=VPN_Admins,OU=Groups,DC=company,DC=local)
# Если пусто — разрешен вход всем пользователям, прошедшим проверку в домене
LDAP_REQUIRED_GROUP=VPN_Admins

# Имя группы или полный DN группы, члены которой получают права администратора панели ('admin').
# Пользователи из LDAP_REQUIRED_GROUP, не входящие в LDAP_ADMIN_GROUP, получают роль 'employee'.
LDAP_ADMIN_GROUP=Domain Admins

# Включить рекурсивный поиск во вложенных группах AD (по умолчанию true)
LDAP_NESTED_GROUPS=true
